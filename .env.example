# Local development. Start with: node --env-file=.env server.mjs
PORT=3100
HOST=0.0.0.0
NODE_ENV=development

# Set the exact HTTPS origin for a public deployment.
# PUBLIC_ORIGIN=https://game.example.com

# Production: choose PostgreSQL OR a file on a persistent volume.
# DATABASE_URL=postgresql://user:password@host:5432/empire?sslmode=verify-full
# ACCOUNT_DATA_FILE=/persistent/empire/accounts.json

# Without either setting, development saves to data/accounts.json.
# Never commit the real .env or account data.
